---
import { PLATFORM_STYLES } from "../embedGrid/platformStyles";
---

<dialog id="help-modal" class="modal">
  <div class="modal-box max-w-2xl">
    <form method="dialog">
      <button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">
        ✕
      </button>
    </form>
    <h3 class="font-bold text-lg mb-4">How to Embed Streams</h3>
    <p class="mb-5 text-sm">
      Paste a complete Twitch, YouTube, or Kick URL. You can also enter the
      channel name or video ID directly using the examples below.
    </p>

    <div class="space-y-6">
      <div>
        <h4
          class:list={[
            "font-semibold text-md mb-2",
            PLATFORM_STYLES.twitch.text,
          ]}
        >
          Twitch
        </h4>
        <p class="text-sm mb-2">
          Paste the channel URL. Stream Mix will select Twitch automatically.
        </p>
        <div class="bg-base-200 p-3 rounded text-sm">
          <p class="mb-1">
            Paste:{" "}
            <code class="text-accent">https://twitch.tv/lofigirl</code>
          </p>
          <p>
            Or enter the channel name:{" "}
            <code class="text-accent font-semibold"> lofigirl </code>
          </p>
        </div>
      </div>

      <div>
        <h4
          class:list={[
            "font-semibold text-md mb-2",
            PLATFORM_STYLES.youtube.text,
          ]}
        >
          YouTube
        </h4>
        <p class="text-sm mb-2">
          Paste a standard, shortened, live, or embed URL. Stream Mix will
          extract the video ID automatically.
        </p>
        <div class="bg-base-200 p-3 rounded text-sm">
          <p class="mb-1">
            Paste:{" "}
            <code class="text-accent">
              https://youtube.com/watch?v=jfKfPfyJRdk
            </code>
          </p>
          <p>
            Or enter the video ID:{" "}
            <code class="text-accent font-semibold"> jfKfPfyJRdk </code>
          </p>
        </div>
      </div>

      <div>
        <h4
          class:list={["font-semibold text-md mb-2", PLATFORM_STYLES.kick.text]}
        >
          Kick
        </h4>
        <p class="text-sm mb-2">
          Paste the channel URL. Stream Mix will select Kick automatically.
        </p>
        <div class="bg-base-200 p-3 rounded text-sm">
          <p class="mb-1">
            Paste:{" "}
            <code class="text-accent">https://kick.com/lofigirl</code>
          </p>
          <p>
            Or enter the channel name:{" "}
            <code class="text-accent font-semibold"> lofigirl </code>
          </p>
        </div>
      </div>

      <div class="border-t border-base-content/15 pt-5">
        <h4 class="font-semibold text-md mb-2">Share your workspace</h4>
        <p class="text-sm">
          After adding and arranging streams, select the share button in the
          site header to copy a link containing the streams, display modes, and
          grid layout. Opening a shared link replaces an existing workspace only
          after confirmation.
        </p>
      </div>

      <nav
        class="border-t border-base-content/15 pt-5"
        aria-label="Stream Mix documentation"
      >
        <h4 class="font-semibold text-md mb-3">Guides</h4>
        <div class="flex flex-wrap gap-2">
          <a
            href="/guides/watch-multiple-streams"
            class="btn btn-primary btn-sm"
          >
            Setup guide
          </a>
          <a
            href="/guides/watch-multiple-twitch-streams"
            class:list={["btn btn-sm", PLATFORM_STYLES.twitch.text]}
          >
            Twitch guide
          </a>
          <a
            href="/guides/watch-multiple-youtube-streams"
            class:list={["btn btn-sm", PLATFORM_STYLES.youtube.text]}
          >
            YouTube guide
          </a>
          <a
            href="/guides/watch-multiple-kick-streams"
            class:list={["btn btn-sm", PLATFORM_STYLES.kick.text]}
          >
            Kick guide
          </a>
        </div>

        <h4 class="font-semibold text-md mt-5 mb-3">More information</h4>
        <div class="flex flex-wrap gap-2">
          <a href="/faq" class="btn btn-sm">FAQ</a>
          <a href="/about" class="btn btn-sm">About</a>
          <a href="/privacy" class="btn btn-sm">Privacy</a>
        </div>
      </nav>
    </div>
  </div>
  <form method="dialog" class="modal-backdrop">
    <button>close</button>
  </form>
</dialog>
